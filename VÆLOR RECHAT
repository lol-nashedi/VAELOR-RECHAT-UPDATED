local function pollChat()
    local data = getJson(chatQueryUrl())
    if type(data) ~= "table" then return end
    local keys = {}
    for k in pairs(data) do table.insert(keys, k) end
    table.sort(keys)

    -- FIX: pehli poll mein purani chat ko 'seen' mark karo (clock mismatch ka issue khatam)
    if firstPoll then
        firstPoll = false
        for _, k in ipairs(keys) do seenMessages[k] = true end
        return
    end

    for _, k in ipairs(keys) do
        local m = data[k]
        if type(m) == "table" and not seenMessages[k] then
            seenMessages[k] = true
            local sender, realName = m.sender or "Unknown", m.realName or ""
            local target = m.target or ""
            local plr = Players:FindFirstChild(realName)
            if plr and plr.DisplayName ~= sender then
                addMessage("SYSTEM", "⚠️ Fake name: " .. plr.DisplayName .. " → " .. sender, "System", true)
                sender = plr.DisplayName
            end
            if realName ~= LP.Name and not mutedUsers[realName] then
                addMessage(sender, m.content or "", realName, false, target)
                if target == "" or target == LP.Name then
                    showToast(sender, m.content or "", realName)
                    bubble(plr, m.content or "")
                end
            end
        end
    end
end

