------------------------------------------------------------------ aura helpers
local function mkPart(parent, p)
    local part = Instance.new(p.Class or "Part")
    part.Size = p.Size or Vector3.new(1, 1, 1)
    part.Color = p.Color or Color3.new(1, 1, 1)
    part.Material = p.Material or Enum.Material.Neon
    if p.Shape then part.Shape = p.Shape end
    part.Transparency = p.Transparency or 0
    part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
    part.Massless, part.Anchored = true, false
    part.Parent = parent
    return part
end

local function joint(class, p0, p1, c0)
    local j = Instance.new(class)
    j.Part0, j.Part1 = p0, p1
    if c0 then j.C0 = c0 end
    j.Parent = p1
    return j
end

local function snapshot(model)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then d:SetAttribute("T", d.Transparency) end
    end
end

local function setVisible(model, visible)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then d.Transparency = visible and (d:GetAttribute("T") or 0) or 1 end
    end
end

-- har frame step(t) chalata hai; local player ke liye AURA toggle off ho to hide
local function animate(player, model, step)
    task.spawn(function()
        local hidden = false
        while model.Parent do
            if player == LP and not auraOn then
                if not hidden then setVisible(model, false); hidden = true end
            else
                if hidden then setVisible(model, true); hidden = false end
                step(tick())
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

