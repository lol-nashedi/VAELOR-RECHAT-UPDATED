------------------------------------------------------------------ auras
local function divineRing(player, root, model)
    local main = mkPart(model, {Shape = BALL, Size = V3(2.4, 2.4, 2.4)})
    local left = mkPart(model, {Shape = BALL, Size = V3(1.6, 1.6, 1.6)})
    local right = mkPart(model, {Shape = BALL, Size = V3(1.6, 1.6, 1.6)})
    local motor = joint("Motor6D", root, main)
    joint("Weld", main, left, CF(-1.1, 1.2, 0))
    joint("Weld", main, right, CF(1.1, 1.2, 0))
    snapshot(model)
    animate(player, model, function(t) motor.C0 = CF(-1.5, 4.5 + math.sin(t * 2) * 0.4, 0.5) end)
end

local function hydraStrike(player, root, model)
    local core = mkPart(model, {Shape = BALL, Size = V3(8, 8, 8), Color = Color3.new(0, 0, 0)})
    local coreMotor = joint("Motor6D", root, core)
    local wedges = {}
    for i = 1, 12 do
        local w = mkPart(model, {Class = "WedgePart", Size = V3(0.2, 2.5, 2.5)})
        table.insert(wedges, {motor = joint("Motor6D", root, w), offset = math.pi * 2 / 12 * i})
    end
    snapshot(model)
    animate(player, model, function(t)
        coreMotor.C0 = CF(0, 5 + math.sin(t * 3) * 2, 8 + math.cos(t * 3)) * CFrame.Angles(0, math.rad(t * 150), 0)
        for _, w in ipairs(wedges) do
            local x = math.cos(t * 2.5 + w.offset) * 6
            local y = math.sin(t * 2.5 + w.offset) * 6 + math.sin(t * 3) * 2
            local pos = V3(x, y + 5, 8)
            w.motor.C0 = CF(pos) * CFrame.lookAt(pos, V3(0, 5, 8)).Rotation * CFrame.Angles(0, math.rad(90), 0)
        end
    end)
end

local function letterA(player, root, model)
    local function bar(size, offset, rot)
        local p = mkPart(model, {Size = size, Transparency = 0.1})
        joint("Weld", root, p, CF(1.8, 3.5, 0.5) * offset * rot)
    end
    bar(V3(0.08, 0.8, 0.08), CF(-0.25, 0, 0), CFrame.Angles(0, 0, math.rad(20)))
    bar(V3(0.08, 0.8, 0.08), CF(0.25, 0, 0), CFrame.Angles(0, 0, math.rad(-20)))
    bar(V3(0.4, 0.08, 0.08), CF(0, 0.2, 0), CFrame.Angles(0, 0, 0))
    local dot = mkPart(model, {Shape = BALL, Size = V3(0.15, 0.15, 0.15), Transparency = 0.05})
    joint("Weld", root, dot, CF(1.8, 3.7, 0.5))
    snapshot(model)
    animate(player, model, function() end)
end

local function bubbles(player, root, model)
    local pastel = {
        Color3.fromRGB(173, 216, 230), Color3.fromRGB(255, 182, 193), Color3.fromRGB(144, 238, 144),
        Color3.fromRGB(255, 255, 224), Color3.fromRGB(216, 191, 216),
    }
    local items = {}
    for _ = 1, 10 do
        local s = 0.6 + math.random() * 0.6
        local p = mkPart(model, {Shape = BALL, Size = V3(s, s, s), Color = pastel[math.random(1, #pastel)], Transparency = 0.4})
        table.insert(items, {
            part = p, motor = joint("Motor6D", root, p), baseSize = s,
            phase = math.random() * 2 * math.pi, radius = 2 + math.random(), speed = 0.5 + math.random() * 0.2,
        })
    end
    snapshot(model)
    animate(player, model, function(t)
        for _, b in ipairs(items) do
            local a = t * b.speed + b.phase
            b.motor.C0 = CF(math.sin(a) * b.radius, math.cos(a) * (b.radius * 0.5) + 2, math.cos(a * 0.8) * b.radius)
            local k = b.baseSize * (0.95 + 0.05 * math.sin(t * 2 + b.phase))
            b.part.Size = V3(k, k, k)
        end
    end)
end

local function heart(player, root, model)
    local dots = {}
    for i = 1, 40 do
        local p = mkPart(model, {Size = V3(0.4, 0.4, 0.4), Color = Color3.fromRGB(255, 105, 180)})
        table.insert(dots, {motor = joint("Motor6D", root, p), a = i / 40 * math.pi * 2})
    end
    snapshot(model)
    animate(player, model, function()
        for _, d in ipairs(dots) do
            local x = 16 * math.sin(d.a) ^ 3
            local y = 13 * math.cos(d.a) - 5 * math.cos(2 * d.a) - 2 * math.cos(3 * d.a) - math.cos(4 * d.a)
            d.motor.C0 = CF(x * 0.12, y * 0.12 + 1, 1.5) * CFrame.Angles(0, 0, math.pi)
        end
    end)
end

-- wings (demon = black, angel = white)
local FEATHERS = {{1.2, 1.2, 65}, {0.8, 0.6, 50}, {0.4, 0.1, 35}, {0, -0.4, 20}, {1.5, 1.8, 85}}
local function buildWing(root, model, left, cfg)
    local sign = left and -1 or 1
    local base = mkPart(model, {Size = V3(2, 2, 2), Color = cfg.color, Material = cfg.baseMat})
    local motor = joint("Motor6D", root, base)
    local joints = {}
    for _, f in ipairs(FEATHERS) do
        local prev = base
        for k, len in ipairs({1, 1.5, 1.2}) do
            local ball = mkPart(model, {Shape = BALL, Size = V3(0.8, 0.8, 0.8), Color = cfg.color})
            local bw = joint("Weld", prev, ball, (k == 1) and CF(f[1] * sign, f[2], 0) or CF(0, -len + 0.2, 0))
            local bone = mkPart(model, {Size = V3(0.7, len, 0.7), Color = cfg.color, Material = cfg.boneMat})
            joint("Weld", ball, bone, CF(0, -len / 2, 0) * CFrame.Angles(0, 0, math.rad(f[3] * (k / 2.5) * sign)))
            if k == 3 then
                local tip = mkPart(model, {Class = "WedgePart", Size = V3(0.5, 4.5, 1.8), Color = cfg.tipColor})
                joint("Weld", bone, tip, CF(0, -1.8, 0.5) * CFrame.Angles(-math.rad(85), 0, 0))
            end
            prev = bone
            table.insert(joints, bw)
        end
    end
    return {motor = motor, joints = joints}
end

local function wings(cfg)
    return function(player, root, model)
        local left = buildWing(root, model, true, cfg)
        local right = buildWing(root, model, false, cfg)
        snapshot(model)
        animate(player, model, function(t)
            local flap = math.sin(t * 1.5) * 0.25
            local bob = math.sin(t * 2) * 0.3
            left.motor.C0 = CF(-2.5, 3.5 + bob, 2.5) * CFrame.Angles(math.rad(155 + flap * 20), -math.rad(15), math.rad(15))
            right.motor.C0 = CF(2.5, 3.5 + bob, 2.5) * CFrame.Angles(math.rad(155 + flap * 20), math.rad(15), math.rad(-15))
            for _, wing in ipairs({left, right}) do
                for k, j in ipairs(wing.joints) do j.C1 = CFrame.Angles(0, 0, math.sin(t + k) * 0.03) end
            end
        end)
    end
end

local demonWings = wings({color = Color3.new(0, 0, 0), baseMat = Enum.Material.Basalt, boneMat = Enum.Material.Slate, tipColor = Color3.new(0, 0, 0)})
local angelWings = wings({color = Color3.fromRGB(255, 255, 255), baseMat = Enum.Material.SmoothPlastic, boneMat = Enum.Material.SmoothPlastic, tipColor = Color3.fromRGB(255, 240, 200)})

local function halo(player, root, model)
    local items = {}
    for i = 1, 6 do
        local p = mkPart(model, {Shape = BALL, Size = V3(0.5, 0.5, 0.5), Transparency = 0.3})
        local a = i / 6 * 2 * math.pi
        table.insert(items, {part = p, motor = joint("Motor6D", root, p, CF(math.cos(a) * 1.3, 4.5, math.sin(a) * 1.3)), base = a})
    end
    snapshot(model)
    animate(player, model, function(t)
        for _, h in ipairs(items) do
            local a = h.base + t * 0.3
            h.motor.C0 = CF(math.cos(a) * 1.3, 4.5 + 0.1 * math.sin(t * 1.5), math.sin(a) * 1.3)
            h.part.Transparency = 0.2 + 0.1 * math.sin(t * 2 + h.base)
        end
    end)
end

local function sniper(player, root, model)
    local dark, mid, black = Color3.fromRGB(20, 20, 20), Color3.fromRGB(40, 40, 40), Color3.fromRGB(30, 30, 30)
    local METAL = Enum.Material.Metal
    local function part(size, color, mat, shape) return mkPart(model, {Size = size, Color = color, Material = mat or METAL, Shape = shape}) end
    local body = part(V3(1.2, 0.9, 3.2), dark)
    local barrel = part(V3(0.45, 0.45, 8), dark)
    local scope = part(V3(0.8, 0.8, 1.4), dark)
    local lens = part(V3(0.7, 0.7, 0.4), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Cylinder)
    local mag = part(V3(0.7, 1, 1.2), mid)
    local magTip = part(V3(0.3, 0.2, 0.3), Color3.new(1, 1, 1))
    local grip = part(V3(0.7, 1.2, 1.2), mid)
    local stock = part(V3(1, 0.8, 3), dark)
    local stockTop = part(V3(0.5, 0.3, 0.8), mid)
    local butt = part(V3(1.5, 1.2, 0.6), dark)
    local bolt1 = part(V3(0.4, 0.8, 0.5), mid)
    local bolt2 = part(V3(0.4, 0.8, 0.5), mid)
    local pad = part(V3(1.6, 1.3, 0.3), black, Enum.Material.Rubber)

    local motor = joint("Motor6D", root, body, CF(2.5, 1.5, 1) * CFrame.Angles(0, math.rad(180), 0))
    joint("Weld", body, barrel, CF(0, 0.1, body.Size.Z / 2 + barrel.Size.Z / 2))
    joint("Weld", body, scope, CF(0, 0.6, -0.9))
    joint("Weld", scope, lens, CF(0, 0, 0.7))
    joint("Weld", body, mag, CF(0.5, -0.4, -1.2))
    joint("Weld", mag, magTip, CF(0, -0.6, 0.2))
    joint("Weld", body, grip, CF(-0.5, -0.6, -0.4))
    joint("Weld", body, stock, CF(0, 0.1, -body.Size.Z / 2 - stock.Size.Z / 2))
    joint("Weld", stock, stockTop, CF(0, 0.6, -1.5))
    joint("Weld", stock, butt, CF(0, -0.5, -stock.Size.Z / 2 - butt.Size.Z / 2))
    joint("Weld", butt, bolt1, CF(-0.8, 0.3, 0))
    joint("Weld", butt, bolt2, CF(0.8, 0.3, 0))
    joint("Weld", butt, pad, CF(0, 0, -butt.Size.Z / 2 - pad.Size.Z / 2))
    snapshot(model)
    animate(player, model, function(t)
        motor.C0 = CF(2.5 + math.sin(t * 0.8) * 0.1, 1.5 + math.sin(t * 2) * 0.1, 1) * CFrame.Angles(0, math.rad(180), 0)
        lens.Transparency = 0.3 + 0.2 * math.sin(t * 3)
    end)
end

local function illuminati(player, root, model)
    local body = mkPart(model, {Shape = BALL, Size = V3(1.8, 1.8, 1.8), Material = Enum.Material.SmoothPlastic, Transparency = 0.1})
    local eye = mkPart(model, {Shape = BALL, Size = V3(1.2, 1.2, 0.4), Color = Color3.fromRGB(0, 191, 255), Transparency = 0.1})
    local pupil = mkPart(model, {Shape = BALL, Size = V3(0.6, 0.6, 0.3), Color = Color3.new(0, 0, 0), Transparency = 0.1})
    local glint = mkPart(model, {Shape = BALL, Size = V3(0.2, 0.2, 0.1), Transparency = 0.2})
    local motor = joint("Motor6D", root, body, CF(0, 5.5, 0) * CFrame.Angles(0, math.rad(180), 0))
    joint("Weld", body, eye, CF(0, 0, 0.6))
    joint("Weld", eye, pupil, CF(0, 0, 0.25))
    joint("Weld", pupil, glint, CF(0.15, 0.15, 0.1))
    snapshot(model)
    animate(player, model, function(t)
        motor.C0 = CF(0, 5.5 + math.sin(t * 2) * 0.2, 0) * CFrame.Angles(0, math.rad(180), 0)
        eye.Transparency = 0.1 + 0.1 * math.sin(t * 3)
        pupil.Transparency = 0.1 + 0.1 * math.sin(t * 4)
        glint.Transparency = 0.2 + 0.1 * math.sin(t * 5)
    end)
end

local AURAS = {
    DIVINE_RING = divineRing, HYDRA_STRIKE = hydraStrike, DEMON_HANDS = demonWings,
    HEART_AURA = heart, LETTER_A = letterA, LETTER_N = bubbles, NORMAL_HALO = halo,
    ANGEL_WINGS = angelWings, BIG_SNIPER = sniper, ILLUMINATI = illuminati,
}

local function applyAura(player, character, style)
    local build = AURAS[style]
    if not build or not character then return end
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
    if not root then return end
    local oldAura = character:FindFirstChild("VXAura")
    if oldAura then oldAura:Destroy() end
    local model = Instance.new("Model")
    model.Name = "VXAura"
    model.Parent = character
    build(player, root, model)
end

-- FIX: sirf real username se VIP milta hai (pehle display name se bhi mil jata tha, koi bhi fake kar sakta tha)
local function vipOf(player) return VIP[player.Name] end

local function setupPlayer(player)
    local function onChar(character)
        local style = auraStyles[player.Name]
        if not style then
            local v = vipOf(player)
            style = v and v.Style
        end
        if style then applyAura(player, character, style) end
    end
    player.CharacterAdded:Connect(onChar)
    if player.Character then task.spawn(onChar, player.Character) end
end
for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)

-- sab players ke aura sync
local function pollAuras()
    local data = getJson(allAurasUrl)
    if type(data) ~= "table" then return end
    for name, info in pairs(data) do
        if type(info) == "table" and info.Style and auraStyles[name] ~= info.Style then
            auraStyles[name] = info.Style
            local plr = Players:FindFirstChild(name)
            if plr and plr.Character then applyAura(plr, plr.Character, info.Style) end
        end
    end
end
task.spawn(function()
    while gui.Parent do
        pcall(pollAuras)
        task.wait(1.5)
    end
end)

