------------------------------------------------------------------ helpers
local req = (syn and syn.request) or (http and http.request) or http_request
    or (fluxus and fluxus.request) or (krnl and krnl.request) or request

local function dbUrl(path, ...)
    local params = {...}
    if AUTH ~= "" then table.insert(params, "auth=" .. AUTH) end
    local u = DB_URL .. path .. ".json"
    if #params > 0 then u = u .. "?" .. table.concat(params, "&") end
    return u
end

local function http(method, url, body)
    if not req or not dbReady then return nil end
    local opts = {Url = url, Method = method}
    if body ~= nil then
        opts.Headers = {["Content-Type"] = "application/json"}
        opts.Body = HttpService:JSONEncode(body)
    end
    local ok, res = pcall(req, opts)
    return ok and res or nil
end

local function getJson(url)
    local res = http("GET", url)
    if not res or not res.Body or res.Body == "null" or res.Body == "" then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    return ok and data or nil
end

local smallMap = {a="ᴀ",b="ʙ",c="ᴄ",d="ᴅ",e="ᴇ",f="ꜰ",g="ɢ",h="ʜ",i="ɪ",j="ᴊ",k="ᴋ",l="ʟ",m="ᴍ",n="ɴ",o="ᴏ",p="ᴘ",q="ǫ",r="ʀ",s="s",t="ᴛ",u="ᴜ",v="ᴠ",w="ᴡ",x="x",y="ʏ",z="ᴢ"}
local function smallCaps(s)
    local out = ""
    for i = 1, #s do
        local ch = s:sub(i, i)
        out = out .. (smallMap[ch:lower()] or ch)
    end
    return out
end

-- chat text safe karo (tags / zalgo hatao)
local function sanitize(s)
    if not s then return "" end
    s = s:gsub("<[^>]*>", ""):gsub("[<>]", ""):gsub("[\204-\205][\128-\191]", ""):gsub("%s+", " ")
    return (s:match("^%s*(.-)%s*$"))
end

-- return: blocked?, reason
local function validate(input)
    if input:find("<[^>]*>") then return true, "HTML tags not allowed" end
    if input:find("[<>]") then return true, "Angle brackets not allowed" end
    if input:find("[\204-\205][\128-\191]") then return true, "Zalgo text not allowed" end
    local letters = input:gsub("[^%a]", "")
    local run, prev = 0, nil
    for ch in letters:gmatch(".") do
        if ch == prev then run += 1 else run = 1; prev = ch end
        if run >= 16 then return true, "Too many repeated letters" end
    end
    if #letters > 10 then
        local caps = select(2, letters:gsub("%u", ""))
        if caps / #letters > 0.8 and caps > 15 then return true, "Too many capital letters" end
    end
    return false
end

