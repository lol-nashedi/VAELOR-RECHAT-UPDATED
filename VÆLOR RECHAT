local function sendMessage()
    local text = textBox.Text
    if text == "" then return end

    local blocked, reason = validate(text)
    if blocked then
        addMessage("SYSTEM", reason, "System", true)
        textBox.Text = ""
        return
    end
    local clean = sanitize(text)
    if clean == "" then
        addMessage("SYSTEM", "Empty message", "System", true)
        textBox.Text = ""
        return
    end
    if os.clock() - lastSend < 2 then textBox.Text = "" return end
    if #clean > 200 then
        addMessage("SYSTEM", "📏 Message too long (max 200 chars)", "System", true)
        textBox.Text = ""
        return
    end

    lastSend = os.clock()
    textBox.Text = ""
    local target, targetDisplay = dmTarget, dmTargetDisplay
    addMessage(LP.DisplayName, clean, LP.Name, false, target, targetDisplay)
    bubble(LP, clean)

    task.spawn(function()
        http("POST", chatUrl, {
            sender = LP.DisplayName, content = clean, realName = LP.Name,
            target = target,
            timestamp = {[".sv"] = "timestamp"}, -- FIX: Firebase server time
        })
    end)
end

